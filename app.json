{
  "expo": {
    "name": "Der Die Das Trainer",
    "slug": "derdiedastrainer2025",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.tunakhan007.derdiedastrainer",
      "appleTeamId": "Y2257DK92G",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.tunakhan007.derdiedastrainer",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3818927199662677~9916153898",
          "iosAppId": "ca-app-pub-3818927199662677~3510537617",
          "userTrackingUsageDescription": "Diese Kennung wird verwendet, um dir passendere Werbung anzuzeigen."
        }
      ],
      "expo-localization",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Diese Kennung wird verwendet, um dir passendere Werbung anzuzeigen."
        }
      ],
      "./plugins/withOptionalPortrait.js",
      "./plugins/withPodsDeploymentTarget.js",
      "./plugins/withIosProjectVersion.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# SDK 58 / R8: WorkManager (genutzt vom Google Mobile Ads SDK) erzeugt seine\n# Room-Datenbank per Reflection - ohne diese Regeln Absturz beim Start.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.impl.** { *; }\n-keep class androidx.startup.** { *; }\n-keep class * implements androidx.startup.Initializer { <init>(); }\n# Google Mobile Ads / UMP\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.google.android.ump.** { *; }\n-dontwarn com.google.android.gms.ads.**"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0124a575-b038-416a-9a9a-10377fbbc7e7"
      }
    },
    "scheme": "derdiedastrainer"
  }
